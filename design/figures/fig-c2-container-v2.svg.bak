<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1500 1100" width="100%" height="100%" style="background:#ffffff;font-family:system-ui,-apple-system,'Microsoft YaHei',sans-serif">
  <defs>
    <filter id="shadow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="1" stdDeviation="2" flood-color="#00000010"/>
    </filter>
    <marker id="arrow-sync" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="6" orient="auto">
      <path d="M 0 1 L 10 5 L 0 9 Z" fill="#64748b"/>
    </marker>
    <marker id="arrow-async" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="6" orient="auto">
      <path d="M 0 1 L 10 5 L 0 9 Z" fill="none" stroke="#64748b" stroke-width="1.5"/>
    </marker>
  </defs>

  <!--
    ============================================================
    v4.10 修复版 (C2 Container Diagram)
    ============================================================
    关键修复:
      1. Python 双虚线捆扎: Python→Agent (任务下发) + Python→MySQL (JDBC 只读) 共起点 (690, 220)
      2. JDBC 虚线终点 (120, 460) 在 MySQL 左侧外边框正中 (箭头尖触到 x=120 边框即停)
      3. 最后一段 (110, 460) → (120, 460) 短 10px 水平向右, 箭头从容器外指向边框
      4. 整条线不再穿过 MySQL 容器内部
    容器坐标:
      Java/MySQL/RabbitMQ: x=120~280
      Python/Redis: x=520~680
      Agent/浏览器池: x=900~1100
  -->

  <!-- ========================================================== -->
  <!-- 1. 元素层 -->
  <!-- ========================================================== -->

  <!-- Level 1: 用户 -->
  <rect x="450" y="40" width="300" height="40" rx="20" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="600" y="65" font-size="14" font-weight="bold" fill="#1f2937" text-anchor="middle">用户</text>

  <!-- Level 2: 业务层 -->
  <rect x="120" y="180" width="160" height="80" rx="8" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="200" y="202" font-size="13" font-weight="bold" fill="#1f2937" text-anchor="middle">Java</text>
  <text x="200" y="218" font-size="10" fill="#6b7280" text-anchor="middle">Spring Boot 3.x</text>
  <text x="200" y="232" font-size="10" fill="#6b7280" text-anchor="middle">简历解析 · 异步分发</text>
  <text x="200" y="246" font-size="9" fill="#9ca3af" text-anchor="middle">[Container]</text>

  <rect x="520" y="180" width="160" height="80" rx="8" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="600" y="202" font-size="13" font-weight="bold" fill="#1f2937" text-anchor="middle">Python</text>
  <text x="600" y="218" font-size="10" fill="#6b7280" text-anchor="middle">FastAPI</text>
  <text x="600" y="232" font-size="10" fill="#6b7280" text-anchor="middle">简历解析</text>
  <text x="600" y="246" font-size="9" fill="#9ca3af" text-anchor="middle">[Container]</text>

  <rect x="900" y="180" width="200" height="80" rx="8" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="1000" y="202" font-size="13" font-weight="bold" fill="#1f2937" text-anchor="middle">本机Agent</text>
  <text x="1000" y="218" font-size="10" fill="#6b7280" text-anchor="middle">Playwright</text>
  <text x="1000" y="232" font-size="10" fill="#6b7280" text-anchor="middle">本机浏览器自动化</text>
  <text x="1000" y="246" font-size="9" fill="#9ca3af" text-anchor="middle">[Container]</text>

  <!-- Level 3: 数据层 -->
  <rect x="120" y="420" width="160" height="80" rx="8" fill="#f0fdf4" stroke="#22c55e" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="200" y="442" font-size="13" font-weight="bold" fill="#1f2937" text-anchor="middle">MySQL 8.0</text>
  <text x="200" y="458" font-size="10" fill="#6b7280" text-anchor="middle">主数据存储</text>
  <text x="200" y="486" font-size="9" fill="#9ca3af" text-anchor="middle">[Container]</text>

  <rect x="520" y="420" width="160" height="80" rx="8" fill="#f0fdf4" stroke="#22c55e" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="600" y="442" font-size="13" font-weight="bold" fill="#1f2937" text-anchor="middle">Redis 7</text>
  <text x="600" y="458" font-size="10" fill="#6b7280" text-anchor="middle">缓存 · 分布式锁</text>
  <text x="600" y="486" font-size="9" fill="#9ca3af" text-anchor="middle">[Container]</text>

  <rect x="900" y="420" width="200" height="80" rx="8" fill="#f8f9fa" stroke="#9ca3af" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="1000" y="442" font-size="13" font-weight="bold" fill="#1f2937" text-anchor="middle">浏览器实例池</text>
  <text x="1000" y="458" font-size="10" fill="#6b7280" text-anchor="middle">Playwright · ≤3</text>
  <text x="1000" y="486" font-size="9" fill="#9ca3af" text-anchor="middle">[Container]</text>

  <!-- Level 4: 共享层 -->
  <rect x="120" y="580" width="160" height="80" rx="8" fill="#fef2f2" stroke="#ef4444" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="200" y="602" font-size="13" font-weight="bold" fill="#1f2937" text-anchor="middle">RabbitMQ</text>
  <text x="200" y="618" font-size="10" fill="#6b7280" text-anchor="middle">异步消息总线</text>
  <text x="200" y="646" font-size="9" fill="#9ca3af" text-anchor="middle">[Container]</text>

  <!-- Level 5: 外部系统 -->
  <rect x="100" y="820" width="1000" height="100" rx="8" fill="none" stroke="#94a3b8" stroke-width="2" stroke-dasharray="6,3"/>
  <text x="115" y="838" font-size="10" font-weight="bold" fill="#94a3b8">外部系统</text>

  <rect x="120" y="860" width="160" height="50" rx="6" fill="#f8f9fa" stroke="#64748b" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="200" y="882" font-size="11" font-weight="bold" fill="#1f2937" text-anchor="middle">LLM 大模型 API</text>
  <text x="200" y="898" font-size="9" fill="#6b7280" text-anchor="middle">GPT-4o</text>

  <rect x="320" y="860" width="160" height="50" rx="6" fill="#f8f9fa" stroke="#64748b" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="400" y="882" font-size="11" font-weight="bold" fill="#1f2937" text-anchor="middle">推送服务</text>
  <text x="400" y="898" font-size="9" fill="#6b7280" text-anchor="middle">邮件/短信/企微</text>

  <rect x="520" y="860" width="160" height="50" rx="6" fill="#f8f9fa" stroke="#64748b" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="600" y="882" font-size="11" font-weight="bold" fill="#1f2937" text-anchor="middle">邮件服务</text>
  <text x="600" y="898" font-size="9" fill="#6b7280" text-anchor="middle">SMTP :465</text>

  <rect x="720" y="860" width="160" height="50" rx="6" fill="#f8f9fa" stroke="#64748b" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="800" y="882" font-size="11" font-weight="bold" fill="#1f2937" text-anchor="middle">支付平台</text>
  <text x="800" y="898" font-size="9" fill="#6b7280" text-anchor="middle">微信/支付宝</text>

  <rect x="920" y="860" width="160" height="50" rx="6" fill="#f8f9fa" stroke="#64748b" stroke-width="1.5" filter="url(#shadow)"/>
  <text x="1000" y="882" font-size="11" font-weight="bold" fill="#1f2937" text-anchor="middle">招聘平台</text>
  <text x="1000" y="898" font-size="9" fill="#6b7280" text-anchor="middle">Boss/拉勾/智联</text>

  <!-- ========================================================== -->
  <!-- 2. 引导线 -->
  <!-- ========================================================== -->
  <line x1="200" y1="150" x2="1000" y2="150" stroke="#e2e8f0" stroke-width="0.5" stroke-dasharray="2,3"/>
  <line x1="200" y1="300" x2="1000" y2="300" stroke="#e2e8f0" stroke-width="0.5" stroke-dasharray="2,3"/>
  <line x1="200" y1="540" x2="1000" y2="540" stroke="#e2e8f0" stroke-width="0.5" stroke-dasharray="2,3"/>
  <line x1="200" y1="780" x2="1000" y2="780" stroke="#e2e8f0" stroke-width="0.5" stroke-dasharray="2,3"/>

  <!-- ========================================================== -->
  <!-- 3. 图例 -->
  <!-- ========================================================== -->
  <rect x="60" y="960" width="1120" height="40" rx="8" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
  <rect x="80" y="975" width="14" height="14" rx="7" fill="#e0f2fe" stroke="#0284c7" stroke-width="1"/>
  <text x="100" y="987" font-size="10" fill="#475569">用户/业务</text>
  <rect x="180" y="975" width="14" height="14" rx="3" fill="#f0fdf4" stroke="#22c55e" stroke-width="1"/>
  <text x="200" y="987" font-size="10" fill="#475569">数据存储</text>
  <rect x="270" y="975" width="14" height="14" rx="3" fill="#fef2f2" stroke="#ef4444" stroke-width="1"/>
  <text x="290" y="987" font-size="10" fill="#475569">消息队列</text>
  <rect x="360" y="975" width="14" height="14" rx="3" fill="#f8f9fa" stroke="#64748b" stroke-width="1"/>
  <text x="380" y="987" font-size="10" fill="#475569">外部系统</text>
  <path d="M 460 982 L 480 982" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-sync)"/>
  <text x="486" y="986" font-size="10" fill="#475569">同步</text>
  <path d="M 540 982 L 560 982" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-async)"/>
  <text x="566" y="986" font-size="10" fill="#475569">异步</text>
  <path d="M 620 982 L 640 982" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="6,4"/>
  <text x="646" y="986" font-size="10" fill="#475569">内部调用</text>

  <!-- ========================================================== -->
  <!-- 4. 连接线 (v4.4: 独立路径 + 单标注) -->
  <!-- ========================================================== -->

  <!-- ========== 捆扎 #1: 用户 → 业务层 (1 主干 + 3 分叉, 实线) ========== -->
  <!-- 主干垂直: (600, 80) → (600, 130) -->
  <path d="M 600 80 L 600 130" fill="none" stroke="#64748b" stroke-width="1.5"/>
  <!-- 主干水平: y=130, x=200~1000 -->
  <path d="M 200 130 L 1000 130" fill="none" stroke="#64748b" stroke-width="1.5"/>
  <!-- 分叉 1: 到 Java -->
  <path d="M 200 130 L 200 180" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-sync)"/>
  <text x="180" y="172" font-size="9" fill="#475569" text-anchor="end">REST API</text>
  <!-- 分叉 2: 到 Python -->
  <path d="M 600 130 L 600 180" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-sync)"/>
  <text x="580" y="172" font-size="9" fill="#475569" text-anchor="end">REST API</text>
  <!-- 分叉 3: 到 Agent -->
  <path d="M 1000 130 L 1000 180" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-sync)"/>
  <text x="1020" y="172" font-size="9" fill="#475569" text-anchor="start">HTTPS API</text>

  <!-- ========== 业务层内部（虚线, 标签改为动态流向） ========== -->
  <!-- Java → Python: 消息同步 (简历结果回传) -->
  <path d="M 280 220 L 520 220" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="6,4" marker-end="url(#arrow-sync)"/>
  <text x="400" y="214" font-size="9" fill="#475569" text-anchor="middle">消息同步</text>
  <!-- ========== Python 双虚线捆扎 (v4.9: Python→Agent 任务下发 + Python→MySQL JDBC 只读 共起点) ========== -->
  <!-- 公共起点: (690, 220) 在 Python 容器右边缘 x=680 外 10px
       捆扎类型: 正向捆扎 (1 源 Python, 2 目标 Agent/MySQL)
       ST-8: 主干 (690, 220) 上两线同虚线类型, 共享段不混入实线 ✅
  -->
  <!-- 公共起点短水平段 (Python 容器内, 从右边缘出) -->
  <path d="M 680 220 L 690 220" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="6,4"/>
  <!-- 分叉 1: Python → Agent 任务下发 (从公共起点向右) -->
  <path d="M 690 220 L 900 220 L 900 260" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="6,4" marker-end="url(#arrow-sync)"/>
  <text x="790" y="214" font-size="9" fill="#475569" text-anchor="middle">任务下发</text>
  <!-- 分叉 2: Python → MySQL JDBC 只读 (从公共起点向下绕行) -->
  <!-- 路径: (690, 220) → (690, 540) → (110, 540) → (110, 460) → (120, 460)
       垂直段 x=690 跨 y=220~540, 完全在 Python/Redis 容器外 10px
       水平段 y=540 x=110~690, 距 MySQL 底 y=500 留 40px, 距 RabbitMQ 顶 y=580 留 40px
       垂直段 x=110 跨 y=460~540, 距 MySQL 左边缘 x=120 留 10px (容器外)
       最后短水平段 (110, 460) → (120, 460) 仅 10px, 箭头向右指向 MySQL 左外边框
       终点 (120, 460) 在 MySQL 左侧外边框正中 (箭头尖触到 x=120 边框即停, 不进容器) -->
  <path d="M 690 220 L 690 540 L 110 540 L 110 460 L 120 460" fill="none" stroke="#64748b" stroke-width="1.5" stroke-dasharray="6,4" marker-end="url(#arrow-sync)"/>
  <text x="395" y="534" font-size="9" fill="#475569" text-anchor="middle">JDBC 只读</text>

  <!-- ========== 业务层 → 数据层 (v4.8: 严格避开所有容器, 各入对应容器) ========== -->
  <!-- 容器坐标基准:
       Java/Python/Agent: y=180~260
       MySQL/Redis/浏览器池: y=420~500
       RabbitMQ: y=580~660
       容器 x 范围: Java/MySQL/RabbitMQ x=120~280, Python/Redis x=520~680, Agent/浏览器池 x=900~1100
  -->

  <!-- Java → MySQL (实线, 最短路径, MySQL 顶正中进入) -->
  <!-- ST-10: 垂直线文字居左, 留出右侧空间给 Java→Redis 水平段 y=380 -->
  <path d="M 200 260 L 200 420" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-sync)"/>
  <text x="190" y="340" font-size="10" font-weight="bold" fill="#1f2937" text-anchor="end">JDBC :3306</text>

  <!-- Python → Redis (实线, 最短路径, Redis 顶正中进入) -->
  <path d="M 600 260 L 600 420" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-sync)"/>
  <text x="610" y="340" font-size="9" fill="#475569">Redis :6379</text>

  <!-- Agent → 浏览器池 (实线, 最短路径) -->
  <path d="M 1000 260 L 1000 420" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-sync)"/>
  <text x="1010" y="340" font-size="9" fill="#475569">CDP</text>

  <!-- ========== Java → Redis (v4.8: 起点水平段 y=266 容器外, 走 y=380 通道) ========== -->
  <!-- 路径: (200, 266) → (230, 266) → (230, 380) → (600, 380) → (600, 420)
       起点水平段 y=266 在 Java 容器底 y=260 下方 6px, 容器外
       垂直段 x=230 跨 y=266~380, 距 Python 容器 x=520 留 290px
       水平段 y=380 x=230~600, 距 MySQL 顶 y=420 留 40px, 不穿 Python (y=180~260)
       终点 (600, 420) 在 Redis 顶正中 -->
  <path d="M 200 266 L 230 266 L 230 380 L 600 380 L 600 420" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-sync)"/>
  <text x="415" y="374" font-size="9" fill="#475569" text-anchor="middle">Redis :6379</text>

  <!-- (Python→MySQL 已在上面"Python 双虚线捆扎"中, 此处不再重复) -->

  <!-- ========== Java → RabbitMQ (v4.8: 起点水平段 y=266 容器外, 与 Java→Redis 错开 x=240) ========== -->
  <!-- 路径: (200, 266) → (240, 266) → (240, 300) → (300, 300) → (300, 560) → (200, 560) → (200, 580)
       起点水平段 y=266 在 Java 容器底外
       垂直段 x=240 跨 y=266~300, 与 Java→Redis 垂直段 x=230 错开 10px
       水平段 y=300 x=240~300 距 MySQL 顶 y=420 留 120px
       垂直段 x=300 跨 y=300~560, 距 MySQL 右边缘 x=280 留 20px
       水平段 y=560 x=200~300 距 MySQL 底 y=500 留 60px, 距 Python→MySQL 水平段 y=540 留 20px
       终点 (200, 580) 在 RabbitMQ 顶正中 -->
  <path d="M 200 266 L 240 266 L 240 300 L 300 300 L 300 560 L 200 560 L 200 580" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-async)"/>
  <text x="260" y="294" font-size="9" fill="#475569">AMQP :5672</text>

  <!-- ========== 捆扎 #3: RabbitMQ → 5 个外部系统 (1 主干 + 5 分叉, 每个分叉独立标协议) ========== -->
  <!-- 主干垂直: (200, 660) → (200, 700) -->
  <path d="M 200 660 L 200 700" fill="none" stroke="#64748b" stroke-width="1.5"/>
  <!-- 主干水平: y=700, x=200~1000 (只画主干, 不重复标注) -->
  <path d="M 200 700 L 1000 700" fill="none" stroke="#64748b" stroke-width="1.5"/>
  <!-- 分叉 1: 到 LLM (HTTPS API) -->
  <path d="M 200 700 L 200 820" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-async)"/>
  <text x="210" y="760" font-size="9" fill="#475569">HTTPS API</text>
  <!-- 分叉 2: 到 推送 (SMTP/短信/企微) -->
  <path d="M 400 700 L 400 820" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-async)"/>
  <text x="410" y="760" font-size="9" fill="#475569">SMTP :465</text>
  <!-- 分叉 3: 到 邮件 (SMTP :465) -->
  <path d="M 600 700 L 600 820" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-async)"/>
  <text x="610" y="760" font-size="9" fill="#475569">SMTP :465</text>
  <!-- 分叉 4: 到 支付 (HTTPS 支付 API) -->
  <path d="M 800 700 L 800 820" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-async)"/>
  <text x="810" y="760" font-size="9" fill="#475569">HTTPS 支付</text>
  <!-- 分叉 5: 到 招聘 (HTTPS 投递 API) -->
  <path d="M 1000 700 L 1000 820" fill="none" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow-async)"/>
  <text x="1010" y="760" font-size="9" fill="#475569">HTTPS 投递</text>
</svg>
