{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "适配器采集结果回写（B10/B11：本机 Agent→服务端，入 B 系列）",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "kind", "jobs"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["searchJobs", "getJobDetail"] },
    "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" }, "minItems": 0 },
    "collectedAt": { "type": "integer", "format": "int64" }
  },
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalJobId", "platformId", "title", "company", "collectedAt"],
      "properties": {
        "externalJobId": { "type": "string", "minLength": 1 },
        "platformId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "company": { "type": "string", "minLength": 1, "maxLength": 200 },
        "url": { "type": "string", "nullable": true },
        "salaryMin": { "type": "integer", "minimum": 0, "nullable": true },
        "salaryMax": { "type": "integer", "minimum": 0, "nullable": true },
        "location": { "type": "string", "nullable": true },
        "description": { "type": "string", "nullable": true },
        "requirements": { "type": "array", "items": { "type": "string" }, "nullable": true },
        "source": { "type": "string", "enum": ["search", "detail"], "default": "search" },
        "collectedAt": { "type": "integer", "format": "int64" }
      }
    }
  }
}
