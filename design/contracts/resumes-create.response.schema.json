{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resumes-create-response",
  "title": "A04 创建简历 - 响应",
  "description": "POST /api/v1/resumes 响应体（统一信封 data 内）。创建即落首个版本快照，返回 resumeId + versionId。",
  "type": "object",
  "properties": {
    "resumeId": { "type": "string", "minLength": 1 },
    "versionId": { "type": "string", "minLength": 1, "description": "初始版本 id（version_no=1）" },
    "createdAt": { "type": "integer", "minimum": 0, "description": "epoch 毫秒" }
  },
  "required": ["resumeId", "versionId", "createdAt"],
  "additionalProperties": false
}
