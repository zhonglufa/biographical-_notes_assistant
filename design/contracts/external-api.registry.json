{
  "contractVersion": "1.0.0",
  "basePath": "/api/v1",
  "uniformEnvelope": {
    "listResponse": "{ items: T[], total: int, page: int, pageSize: int }",
    "itemResponse": "{ data: T }",
    "error": "error-envelope"
  },
  "endpoints": [
    { "id": "A01", "method": "POST", "path": "/auth/login", "purpose": "登录（邮箱/验证码/微信）", "auth": "none", "contractStatus": "outlined", "requestFields": ["email", "channel(enum email|sms|wechat)", "code|password", "deviceId"], "responseFields": ["accessToken", "refreshToken", "expiresIn", "userId", "plan"] },
    { "id": "A02", "method": "POST", "path": "/auth/refresh", "purpose": "刷新令牌", "auth": "Bearer", "contractStatus": "outlined", "requestFields": ["refreshToken"], "responseFields": ["accessToken", "expiresIn"] },
    { "id": "A03", "method": "GET", "path": "/users/me", "purpose": "当前用户与权益", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "user-me.response.schema.json", "requestFields": null, "responseFields": ["userId", "email", "plan", "quotaUsed", "quotaLimit", "preferences"] },
    { "id": "A04", "method": "POST", "path": "/resumes", "purpose": "创建简历", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "resumes-create.request.schema.json / resumes-create.response.schema.json", "requestFields": ["title", "content", "templateId?"], "responseFields": ["resumeId", "versionId", "createdAt"] },
    { "id": "A05", "method": "GET", "path": "/resumes/{id}/versions", "purpose": "版本列表 + diff", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "resume-versions.response.schema.json / resume-diff.request.schema.json / resume-diff.response.schema.json", "requestFields": null, "responseFields": ["versions:[versionId, versionNo, createdAt, isPreferred]", "diffAvailable:bool"] },
    { "id": "A06", "method": "POST", "path": "/resumes/{id}/ats", "purpose": "触发 ATS 评分", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "resume-ats.request.schema.json / resume-ats.response.schema.json", "requestFields": ["resumeVersionId"], "responseFields": ["taskId", "status(enum pending|running|done|failed)"] },
    { "id": "A07", "method": "GET", "path": "/jobs", "purpose": "岗位列表（筛选/分页）", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "jobs-search.request.schema.json / jobs-list.response.schema.json", "requestFields": ["keyword?", "location?", "platform?", "page", "pageSize", "salaryMin?"], "responseFields": ["items:[jobStub]", "total", "page", "pageSize"] },
    { "id": "A08", "method": "POST", "path": "/jobs/{id}/favorite", "purpose": "收藏/忽略", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "jobs-favorite.request.schema.json / jobs-favorite.response.schema.json", "requestFields": ["action(enum favorite|ignore)"], "responseFields": ["ok", "status(enum favorited|ignored|removed)"] },
    { "id": "A09", "method": "POST", "path": "/applications/batch", "purpose": "批量发起投递（确认队列）", "auth": "Bearer+role", "contractStatus": "fully-detailed", "ref": "HLD §4.2" },
    { "id": "A10", "method": "GET", "path": "/applications", "purpose": "投递记录列表", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "applications-list.response.schema.json", "requestFields": ["platform?", "status?", "page", "pageSize"], "responseFields": ["items:[applicationStub]", "total"] },
    { "id": "A11", "method": "GET", "path": "/applications/{id}", "purpose": "单条投递详情（含状态机）", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "HLD §4.3" },
    { "id": "A12", "method": "GET", "path": "/strategies", "purpose": "读取策略配置", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "strategies.response.schema.json", "requestFields": null, "responseFields": ["matchThreshold", "dailyLimit", "platforms:[]", "blacklist:[]"] },
    { "id": "A13", "method": "PUT", "path": "/strategies", "purpose": "更新策略配置（PC）", "auth": "Bearer+pro", "contractStatus": "fully-detailed", "ref": "strategies.request.schema.json / strategies.response.schema.json", "requestFields": ["matchThreshold", "dailyLimit", "platforms", "blacklist"], "responseFields": ["ok", "updatedAt"] },
    { "id": "A14", "method": "GET", "path": "/adapters", "purpose": "适配器列表与状态", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "HLD §4.4" },
    { "id": "A15", "method": "POST", "path": "/adapters/{id}/enable", "purpose": "启用/停用适配器", "auth": "Bearer+pro", "contractStatus": "outlined", "requestFields": ["enabled(bool)"], "responseFields": ["adapterId", "status"] },
    { "id": "A16", "method": "GET", "path": "/interviews/questions", "purpose": "面试题列表（备战）", "auth": "Bearer", "contractStatus": "outlined", "requestFields": null, "responseFields": ["questionSets:[]"] },
    { "id": "A17", "method": "POST", "path": "/interviews/sessions", "purpose": "创建 AI 面试会话", "auth": "Bearer", "contractStatus": "outlined", "requestFields": ["jobId?", "mode(enum text|voice)", "questionSetId?"], "responseFields": ["sessionId", "status"] },
    { "id": "A18", "method": "POST", "path": "/interviews/sessions/{id}/answer", "purpose": "提交作答（文本/语音）", "auth": "Bearer", "contractStatus": "outlined", "requestFields": ["questionId", "answer(text|audioRef)", "asrProvider?"], "responseFields": ["accepted", "score?"] },
    { "id": "A19", "method": "GET", "path": "/interviews/sessions/{id}/report", "purpose": "评估报告", "auth": "Bearer", "contractStatus": "outlined", "requestFields": null, "responseFields": ["sessionId", "overallScore", "rubric:[]", "feedback"] },
    { "id": "A20", "method": "POST", "path": "/payments/orders", "purpose": "创建会员订单", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "payments-order.request.schema.json / payments-order.response.schema.json", "requestFields": ["plan(enum pro|team)", "months", "coupon?"], "responseFields": ["orderNo", "payUrl", "amount(分)", "expireAt(epoch ms)"] },
    { "id": "A21", "method": "POST", "path": "/payments/callback", "purpose": "支付渠道回调", "auth": "channel-signature", "contractStatus": "fully-detailed", "ref": "HLD §4.10 + payments-callback.request.schema.json" },
    { "id": "A22", "method": "GET", "path": "/notifications", "purpose": "通知列表", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "notifications-list.response.schema.json", "requestFields": ["level?", "page", "pageSize"], "responseFields": ["items:[notification]", "unread"] },
    { "id": "A23", "method": "GET", "path": "/notifications/ws", "purpose": "WebSocket 连接（推送）", "auth": "Bearer(query)", "contractStatus": "outlined", "requestFields": null, "responseFields": ["wsUrl"] },
    { "id": "A24", "method": "GET", "path": "/daily-report/today", "purpose": "获取今日日报摘要", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "daily-report-today.response.schema.json", "requestFields": null, "responseFields": ["date", "summary", "stats"] },
    { "id": "A25", "method": "PUT", "path": "/users/daily-report/preference", "purpose": "设置日报推送时间偏好", "auth": "Bearer", "contractStatus": "fully-detailed", "ref": "daily-report-preference.request.schema.json / daily-report-preference.response.schema.json", "requestFields": ["pushTime", "enabled"], "responseFields": ["ok", "updatedAt"] }
  ]
}
