{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auth-refresh-response",
  "title": "A02 刷新令牌 - 响应",
  "description": "POST /api/v1/auth/refresh 响应体。返回新 accessToken；refreshToken 轮转时一并返回，否则为 null。",
  "type": "object",
  "properties": {
    "accessToken": { "type": "string", "minLength": 1 },
    "expiresIn": { "type": "integer", "minimum": 1 },
    "refreshToken": { "type": ["string", "null"], "description": "轮转后的新刷新令牌，未轮转时为 null" }
  },
  "required": ["accessToken", "expiresIn"],
  "additionalProperties": false
}
