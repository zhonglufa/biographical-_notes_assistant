{
  "schemas": {
    "error-envelope.schema.json": {
      "valid": [
        { "code": "UNAUTHORIZED", "message": "令牌失效", "traceId": "tr-001", "retryable": false, "user_action": "重新登录" },
        { "code": "RATE_LIMITED", "message": "触发限流", "traceId": "tr-002", "retryable": true, "user_action": null }
      ],
      "invalid": [
        { "payload": { "code": "UNAUTHORIZED", "message": "x", "traceId": "t" }, "reason": "缺必需字段 retryable" },
        { "payload": { "code": 123, "message": "x", "traceId": "t", "retryable": false }, "reason": "code 非字符串" },
        { "payload": { "code": "UNAUTHORIZED", "message": "x", "traceId": "t", "retryable": false, "extra": 1 }, "reason": "存在未声明额外字段" }
      ]
    },
    "event-envelope.schema.json": {
      "valid": [
        { "eventType": "apply.task.created", "traceId": "t1", "ts": 1700000000000, "producer": "java-state-machine", "payload": { "taskId": "T1" } },
        { "eventType": "hr.viewed.detected", "traceId": "t2", "ts": 1700000000001, "producer": "java-poll", "payload": {}, "dedupKey": "k1" }
      ],
      "invalid": [
        { "payload": { "eventType": "x", "traceId": "t", "ts": 1, "producer": "p" }, "reason": "缺必需字段 payload" },
        { "payload": { "eventType": "x", "traceId": "t", "ts": "now", "producer": "p", "payload": {} }, "reason": "ts 非整数" },
        { "payload": { "eventType": "x", "traceId": "t", "ts": 1, "producer": "p", "payload": {}, "unknown": true }, "reason": "存在未声明额外字段" }
      ]
    },
    "rpc-envelope.schema.json": {
      "valid": [
        { "traceId": "t", "ts": 123, "method": "ApplyTask.Deliver" },
        { "traceId": "t", "ts": 123, "method": "ApplyTask.Deliver", "idempotencyKey": "u1", "params": { "a": 1 } },
        { "traceId": "t", "ok": true, "result": { "taskId": "T1", "accepted": true } },
        { "traceId": "t", "ok": false, "error": { "code": "ADAPTER_UNAVAILABLE", "message": "m", "retryable": true } }
      ],
      "invalid": [
        { "payload": { "traceId": "t", "ts": 1 }, "reason": "非请求(缺 method) 非响应(缺 ok) → oneOf 0 匹配" },
        { "payload": { "traceId": "t", "ok": true, "method": "X" }, "reason": "响应含 method → additionalProperties 失败" },
        { "payload": { "traceId": "t", "ok": false, "error": { "message": "m", "retryable": false } }, "reason": "error 缺 code" }
      ]
    }
  },
  "registryFiles": {
    "error-codes.json": "error-codes.schema.json",
    "agent-server-rpc.methods.json": "agent-server-rpc.registry.schema.json"
  }
}
