{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily-report-today-response",
  "title": "A24 今日日报摘要 - 响应",
  "description": "GET /api/v1/daily-report/today 响应体（统一信封 data 内）。Cron 20:00 聚合落库后返回；当日无活动返回空 stats 摘要（不发送空日报，PRD 模块 9 边界）。",
  "type": "object",
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD" },
    "summary": { "type": "string", "description": "人类可读摘要" },
    "stats": {
      "type": "object",
      "properties": {
        "appliedTotal": { "type": "integer", "minimum": 0 },
        "success": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "byPlatform": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "platformId": { "type": "string", "minLength": 1 }, "count": { "type": "integer", "minimum": 0 } },
            "required": ["platformId", "count"],
            "additionalProperties": false
          }
        },
        "hrViews": { "type": "integer", "minimum": 0 },
        "interviewInvites": { "type": "integer", "minimum": 0 },
        "newQuestions": { "type": "integer", "minimum": 0 },
        "trend7d": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "count": { "type": "integer", "minimum": 0 } },
            "required": ["date", "count"],
            "additionalProperties": false
          }
        }
      },
      "required": ["appliedTotal", "success", "failed", "byPlatform", "hrViews", "interviewInvites", "newQuestions", "trend7d"],
      "additionalProperties": false
    }
  },
  "required": ["date", "summary", "stats"],
  "additionalProperties": false
}
