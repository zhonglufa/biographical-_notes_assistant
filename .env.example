# resume-ai-prod 服务端配置模板
# 用法：复制为 .env，由 `docker compose --env-file .env up` 或手工 `export` 注入。
# 全部项均有安全默认值；真实密钥/阈值由运维设定，禁止把真实值提交进仓库。

# ---- 服务监听 ----
PORT=8080
HOST=0.0.0.0

# ---- LLM 网关（护栏2 成本硬上限由 cost_policy.DEFAULT_DAILY_CAP_CENTS 控制；
#      此处仅注入网关地址与密钥。当前 server_main 为契约桩服务，真实 LLM 网关
#      接入见 docs/上线手册.md 阶段二说明；密钥禁止入库）----
# LLM_GATEWAY_URL=https://api.your-llm.com/v1
# LLM_API_KEY=

# ---- 护栏3 监控阈值（超过即告警；生产值由运维按容量设定）----
# BAN_RATE_THRESHOLD=0.05
# ERROR_RATE_THRESHOLD=0.05
# LLM_DAILY_CAP_CENTS=2000

# ---- 前端来源（CORS / 回调跳转，可选）----
# FRONTEND_ORIGIN=http://localhost:5173
