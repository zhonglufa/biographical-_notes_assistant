# resume-ai-prod 全栈配置模板（上线阶段二 · 真实业务服务）
# 用法：复制为 .env，由 `docker compose --env-file .env up -d --build` 注入。
# 红线：禁止把真实密钥/凭据提交进仓库；私钥/令牌由密钥管理(KMS)或本机 .env 注入，.env 不入库。

# ===== 基础设施 =====
DB_USER=root
DB_PASS=root
REDIS_HOST=redis
RABBIT_USER=guest
RABBIT_PASS=guest
# RabbitMQ 模式：生产必填 rabbit（真正异步投递）；memory=开发同步桩（无 broker，消费者不启用）
MQ_MODE=rabbit
# 启用 RabbitMQ 健康探活（MQ_MODE=rabbit 时置 true，否则 /health 误报 DOWN）
MQ_RABBIT_HEALTH=true

# ===== server-java（业务后端 :8080） =====
# RS256 密钥（PEM，私钥/公钥成对）。生产必须注入；留空→启动生成临时 RSA-2048（开发模式，重启失效，WARN 日志）。
# 私钥严禁入库 / 进镜像。
RESIMEAI_JWT_PRIVATE_KEY=
RESIMEAI_JWT_PUBLIC_KEY=
# 本机 Agent 回调基址（服务端→用户机器派发投递任务；服务端不持 Cookie/平台凭据）。
# 容器内访问宿主机用 host.docker.internal（已在 compose 配 host-gateway）；若本机 Agent 在同网络改对应地址。
AGENT_CALLBACK_BASE_URL=http://host.docker.internal:9800

# ===== server-python（LLM 网关 :8000） =====
# 内部令牌：生产必须设置，缺失→fail-closed 拒绝全部内部调用（无 dev 兜底/无后门）
INTERNAL_TOKEN=
# LLM 网关（DeepSeek 示例；缺失 API Key→网关不可用→自动三级降级链兜底，防生产事故）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_MODEL=deepseek-chat
LLM_BACKUP_MODEL=deepseek-chat
# 护栏2 成本预算（生产值按预算设定；DEMO 默认偏宽松）
LLM_DAILY_CAP_CENTS=50000
LLM_PER_CALL_CENTS=10
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_S=60
# 护栏3 监控阈值（超过即告警；生产值按容量设定）
MON_ERROR_RATE_MAX=0.05
MON_BAN_RATE_MAX=0.02
MON_APPLY_SUCCESS_MIN=0.80
# 护栏4/6 特性开关覆盖文件 + 审计日志路径（可选持久化）
FEATURE_FLAGS_OVERRIDES=
AUDIT_LOG_PATH=

# ===== 前端 =====
# 前端构建期注入的 API 根路径（默认相对 /api，由 nginx 反代到 server-java）
VITE_API_BASE=/api
